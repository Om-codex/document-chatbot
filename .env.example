# Copy this file to .env and fill in the required keys below.
# Never commit .env — it is ignored by git.
# Variable names map case-insensitively to config/settings.py fields.
# Required for full functionality: GROQ_API_KEY, GEMINI_API_KEY,
# QDRANT_URL, QDRANT_API_KEY and JWT_SECRET_KEY.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Document Chatbot API
APP_VERSION=1.0.0
LOG_LEVEL=INFO
# JSON list of allowed browser origins. Local dev example below.
# In production set this to the exact frontend origin (no trailing slash), e.g.
# CORS_ALLOW_ORIGINS=["https://document-chatbot.omm512462.workers.dev"]
CORS_ALLOW_ORIGINS=["*"]

# ---------------------------------------------------------------------------
# Database (SQLAlchemy / SQLite)
# ---------------------------------------------------------------------------
# Defaults to a SQLite file at data/users.db in the project root.
# For Neon/Postgres with psycopg v3, use e.g.
# postgresql+psycopg://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///data/users.db

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# Required. Must be a random string of at least 32 bytes.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Signing algorithm is fixed to HS256 in auth/token.py (not configurable).

# ---------------------------------------------------------------------------
# LLM (Groq)
# ---------------------------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Free-tier chat models as of 2026: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.8-27b. Llama models are enterprise-only now.
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Embeddings (Google Gemini API)
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=6
EMBEDDING_INITIAL_BACKOFF_SECONDS=3.0
NORMALIZE_EMBEDDINGS=true

# ---------------------------------------------------------------------------
# Embeddings (local Hugging Face — kept for rollback reference only)
# ---------------------------------------------------------------------------
# Downloaded once to the Hugging Face cache (~90 MB), then runs offline on CPU.
# EMBEDDING_MODEL (without the _NAME suffix) is also accepted for compatibility.
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu

# ---------------------------------------------------------------------------
# Ingestion / Text Splitting
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Keep the default small on Groq's free tier (8K tokens/minute).
DEFAULT_TOP_K=3
MAX_TOP_K=20
MAX_QUESTION_LENGTH=4000
MAX_SELECTED_DOCUMENTS=50

# ---------------------------------------------------------------------------
# Storage (relative paths are resolved against the project root)
# ---------------------------------------------------------------------------
# ChromaDB settings are retained for rollback only; the active store is Qdrant.
CHROMA_COLLECTION_NAME=document_collection_v2
CHROMA_PERSIST_DIRECTORY=data/chroma_db
UPLOAD_DIRECTORY=data/uploads
UPLOAD_READ_CHUNK_SIZE=1048576

# ---------------------------------------------------------------------------
# Qdrant Cloud (active vector store)
# ---------------------------------------------------------------------------
# Get URL and API key from https://cloud.qdrant.io/
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_collection_v2_gemini
QDRANT_DISTANCE=Cosine
QDRANT_UPSERT_BATCH_SIZE=100
QDRANT_TIMEOUT_SECONDS=30.0

# ---------------------------------------------------------------------------
# Outbound HTTP client timeout (Qdrant, Groq, Gemini)
# ---------------------------------------------------------------------------
HTTP_REQUEST_TIMEOUT_SECONDS=30.0

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_FILE_SIZE_BYTES=10485760
MAX_FILENAME_LENGTH=200
# JSON list; also enforced client-side by the frontend.
ALLOWED_EXTENSIONS=[".pdf", ".docx", ".txt"]
